# SANKALP Environment Configuration Example

# FastAPI Backend Settings
SANKALP_ENV=development
API_PORT=8000
API_HOST=127.0.0.1

# SQLite Database Location
SANKALP_DB_PATH=data/sankalp.sqlite3

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sankalp.vercel.app

# Next.js Frontend Settings
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
